#!/usr/bin/env python3
import json
import os
import pwd
import re
import subprocess
import sys
import tempfile

USER_RE = re.compile(r"^prod_[A-Za-z0-9_.-]{1,64}$")
ALLOWED_KEY_TYPES = {
    "ssh-ed25519",
    "ecdsa-sha2-nistp256",
    "ecdsa-sha2-nistp384",
    "ecdsa-sha2-nistp521",
    "sk-ssh-ed25519@openssh.com",
    "ssh-rsa",
}

BEGIN = "# BEGIN db-ip-portal managed key"
END = "# END db-ip-portal managed key"

def fail(message, code=1):
    print(json.dumps({"ok": False, "error": message}))
    raise SystemExit(code)

def validate_user(username):
    if not USER_RE.match(username):
        fail("Usuario inválido. Debe iniciar con prod_")
    try:
        info = pwd.getpwnam(username)
    except KeyError:
        fail("El usuario Linux no existe")
    if not info.pw_dir.startswith("/home/"):
        fail("Home inválido para el usuario")
    return info

def auth_file(info):
    ssh_dir = os.path.join(info.pw_dir, ".ssh")
    return ssh_dir, os.path.join(ssh_dir, "authorized_keys")

def read_auth(info):
    _, path = auth_file(info)
    if not os.path.exists(path):
        return ""
    with open(path, "r", encoding="utf-8") as f:
        return f.read()

def has_managed_key(info):
    content = read_auth(info)
    inside = False
    for line in content.splitlines():
        stripped = line.strip()
        if stripped == BEGIN:
            inside = True
            continue
        if stripped == END:
            inside = False
            continue
        if inside and stripped and not stripped.startswith("#"):
            return True
    return False

def validate_public_key(public_key):
    public_key = public_key.strip()

    if "\n" in public_key or "\r" in public_key:
        fail("Pega solo una llave pública en una línea")

    parts = public_key.split()
    if len(parts) < 2:
        fail("Formato de llave pública inválido")

    key_type = parts[0]
    if key_type not in ALLOWED_KEY_TYPES:
        fail(f"Tipo de llave no permitido: {key_type}")

    fd, tmp = tempfile.mkstemp(prefix="dbip-key.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(public_key + "\n")

        result = subprocess.run(
            ["ssh-keygen", "-l", "-f", tmp],
            text=True,
            capture_output=True
        )
        if result.returncode != 0:
            fail("La llave pública no es válida")
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)

    return public_key

def install_key(username):
    info = validate_user(username)
    public_key = sys.stdin.read(8192)
    public_key = validate_public_key(public_key)

    ssh_dir, path = auth_file(info)
    os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
    os.chown(ssh_dir, info.pw_uid, info.pw_gid)
    os.chmod(ssh_dir, 0o700)

    existing = read_auth(info)
    lines = existing.splitlines()

    new_lines = []
    inside = False
    for line in lines:
        if line.strip() == BEGIN:
            inside = True
            continue
        if line.strip() == END:
            inside = False
            continue
        if not inside:
            new_lines.append(line)

    managed_line = (
        'restrict,port-forwarding,'
        'permitopen="127.0.0.1:3306",'
        'permitopen="127.0.0.1:5432" '
        + public_key
    )

    new_lines.append(BEGIN)
    new_lines.append(managed_line)
    new_lines.append(END)

    with open(path, "w", encoding="utf-8") as f:
        f.write("\n".join(new_lines).strip() + "\n")

    os.chown(path, info.pw_uid, info.pw_gid)
    os.chmod(path, 0o600)

    print(json.dumps({"ok": True, "user": username, "has_key": True}))

def status(username):
    info = validate_user(username)
    print(json.dumps({
        "ok": True,
        "user": username,
        "has_key": has_managed_key(info)
    }))

def main():
    if len(sys.argv) != 3:
        fail("Uso: dbip-sshkey status <usuario> | install <usuario>")

    action = sys.argv[1]
    username = sys.argv[2]

    if action == "status":
        status(username)
    elif action == "install":
        install_key(username)
    else:
        fail("Acción inválida")

if __name__ == "__main__":
    main()
