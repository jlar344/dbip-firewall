# Managed by Ansible — db_ip_access_manager
# PermitOpen from dbip_forward_destinations (inventory source of truth)
Match User prod_*
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    PubkeyAuthentication yes
    AllowTcpForwarding local
    GatewayPorts no
    PermitOpen {% for d in dbip_forward_destinations %}{{ d.host }}:{{ d.port }}{% if not loop.last %} {% endif %}{% endfor %}

    PermitTTY no
    X11Forwarding no
    AllowAgentForwarding no
    ForceCommand /bin/false
